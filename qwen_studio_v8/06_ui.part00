def _pretty_prepare_status():
    ready_models = bool(BOOTSTRAP_STATE.get('models_ready'))
    ready_runtime = bool(BOOTSTRAP_STATE.get('runtime_ready'))
    phase = BOOTSTRAP_STATE.get('phase','idle')
    details = BOOTSTRAP_STATE.get('details','')
    err = BOOTSTRAP_STATE.get('last_error','')
    if ready_models and ready_runtime:
        headline = '✅ Prêt à générer'
    elif err:
        headline = '⚠️ Préparation à vérifier'
    else:
        headline = '⏳ Préparation en cours'
    lines = [headline, f'Phase : {phase}', details]
    if err:
        lines.append('Erreur : ' + err[-700:])
    return '\n'.join(x for x in lines if x)

def _prepare_now():
    msg = start_background_prepare(force=True)
    return msg, _pretty_prepare_status(), jobs_table()

def _prepare_status():
    return _pretty_prepare_status(), jobs_table()

def _submit_gen(prompt, aspect, steps, cfg, seed):
    try:
        j=submit_generate_job(prompt,aspect,steps,cfg,seed)
        return j['id'], f"Tâche lancée • {j['id']}", jobs_table()
    except Exception as e:
        raise gr.Error(str(e))

def _submit_edit(prompt,image,aspect,steps,cfg,seed):
    try:
        j=submit_edit_job(prompt,image,aspect,steps,cfg,seed)
        return j['id'], f"Édition lancée • {j['id']}", jobs_table()
    except Exception as e:
        raise gr.Error(str(e))

def _submit_fs(src,tgt):
