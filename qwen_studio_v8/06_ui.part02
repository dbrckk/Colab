                    e_btn=gr.Button('✏️ Modifier',variant='primary',elem_classes=['primary-btn'])
                    edit_job=gr.Textbox(visible=False)
                    edit_submit_info=gr.Textbox(label='État',lines=2,interactive=False)
                    edit_refresh=gr.Button('↻ Voir le résultat', elem_classes=['secondary-btn'])
                    edit_status=gr.Textbox(label='Progression',lines=3,interactive=False)
                with gr.Column(scale=6, elem_classes=['glass']):
                    e_out=gr.Image(label='Résultat',type='filepath',elem_classes=['result-image'],height=520)
                    e_info=gr.Textbox(visible=False)
            edit_latest.click(_copy_latest_to_edit,[],[edit_image,e_info])
            e_btn.click(_submit_edit,[edit_prompt,edit_image,e_aspect,e_steps,e_cfg,e_seed],[edit_job,edit_submit_info,jobs_box])
            edit_refresh.click(_refresh_job,[edit_job],[edit_status,e_out,e_info,jobs_box])

        with gr.Tab('🙂 Face swap'):
            with gr.Row():
                with gr.Column(scale=5, elem_classes=['glass']):
                    fs_src=gr.Image(label='Visage source',type='filepath',height=260)
                    fs_tgt=gr.Image(label='Image cible',type='filepath',height=260)
                    fs_latest=gr.Button('↙ Utiliser la dernière image comme cible', elem_classes=['secondary-btn'])
                    fs_btn=gr.Button('🙂 Face swap',variant='primary',elem_classes=['primary-btn'])
                    fs_job=gr.Textbox(visible=False)
                    fs_submit_info=gr.Textbox(label='État',lines=2,interactive=False)
                    fs_refresh=gr.Button('↻ Voir le résultat', elem_classes=['secondary-btn'])
                    fs_status=gr.Textbox(label='Progression',lines=3,interactive=False)
                with gr.Column(scale=6, elem_classes=['glass']):
                    fs_out=gr.Image(label='Résultat',type='filepath',elem_classes=['result-image'],height=520)
                    fs_info=gr.Textbox(visible=False)
            fs_latest.click(latest_image,[],[fs_tgt,fs_info])
            fs_btn.click(_submit_fs,[fs_src,fs_tgt],[fs_job,fs_submit_info,jobs_box])
            fs_refresh.click(_refresh_job,[fs_job],[fs_status,fs_out,fs_info,jobs_box])


        with gr.Tab('🎬 Face swap vidéo Ultra'):
            with gr.Row():
                with gr.Column(scale=5, elem_classes=['glass']):
                    gr.Markdown(
                        "### Face swap vidéo Ultra v8.6\n"
                        "Suivi strict, garde-fous anti-occlusion, préservation de la bouche, "
                        "FaceFusion Ultra optionnel, analyse automatique, checkpoints, pause/reprise, "
                        "progression/ETA et annulation."
                    )
                    vfs_src=gr.Image(label='Visage source',type='filepath',height=250)
                    vfs_tgt=gr.Video(label='Vidéo cible',height=300)
                    with gr.Row():
                        vfs_analyze=gr.Button('🔎 Analyser la vidéo',elem_classes=['secondary-btn'])
                        vfs_backend=gr.Dropdown(
                            ['auto','builtin-ultra','facefusion-ultra'],
                            value='auto',
                            label='Backend vidéo'
                        )
                    vfs_analysis=gr.Textbox(label='Analyse / recommandation',lines=4,interactive=False)
                    gr.Markdown(
                        '\`auto\` reste léger au démarrage. '
                        '\`facefusion-ultra\` utilise son environnement séparé avec masques occlusion/région, '
                        'expression restorer et face enhancer.'
                    )
                    with gr.Accordion('Qualité / robustesse',open=False):
                        vfs_stride=gr.Slider(1,4,value=VIDEO_FACE_SWAP_FRAME_STRIDE,step=1,label='Frame stride • 1 recommandé')
                        vfs_detect_every=gr.Slider(1,1,value=1,step=1,label='Détection visage • chaque frame en mode Ultra',interactive=False)
                        vfs_max_frames=gr.Number(value=VIDEO_FACE_SWAP_MAX_FRAMES,precision=0,label='Max frames • 0 = aucune limite')
                        vfs_preview_seconds=gr.Number(value=VIDEO_FACE_SWAP_PREFLIGHT_SECONDS,precision=0,label='Aperçu automatique avant rendu (secondes)')
                        vfs_keep_audio=gr.Checkbox(value=VIDEO_FACE_SWAP_KEEP_AUDIO,label='Conserver l’audio')
                        with gr.Row():
                            vfs_crf=gr.Slider(14,24,value=VIDEO_FACE_SWAP_CRF,step=1,label='CRF • 17 recommandé')
                            vfs_preset=gr.Dropdown(['medium','slow','slower'],value=VIDEO_FACE_SWAP_PRESET,label='Encodage')
                    with gr.Accordion('Vidéo avec plusieurs personnes',open=False):
                        gr.Markdown('Position 0 = plus grand visage sur la frame de référence. 1 = deuxième, etc. Le tracking verrouille ensuite cette personne.')
                        with gr.Row():
                            vfs_target_face_position=gr.Number(value=VIDEO_FACE_SWAP_TARGET_FACE_POSITION,precision=0,label='Position du visage cible')
                            vfs_reference_frame=gr.Number(value=VIDEO_FACE_SWAP_REFERENCE_FRAME,precision=0,label='Frame de référence')
                        vfs_reference_distance=gr.Slider(0.05,1.0,value=VIDEO_FACE_SWAP_REFERENCE_DISTANCE,step=0.05,label='Tolérance identité FaceFusion')
                    with gr.Row():
                        vfs_preview_btn=gr.Button('👁 Aperçu rapide',elem_classes=['secondary-btn'])
                        vfs_btn=gr.Button('🎬 Rendu complet',variant='primary',elem_classes=['primary-btn'])
                    with gr.Row():
                        vfs_pause=gr.Button('⏸ Pause',elem_classes=['secondary-btn'])
                        vfs_resume=gr.Button('▶ Reprendre',elem_classes=['secondary-btn'])
                        vfs_restart=gr.Button('↻ Reprendre après interruption',elem_classes=['secondary-btn'])
                        vfs_cancel=gr.Button('⛔ Annuler',variant='stop')
                    vfs_job=gr.Textbox(label='Job ID',interactive=False)
                    vfs_submit_info=gr.Textbox(label='État',lines=2,interactive=False)
                    vfs_refresh=gr.Button('↻ Actualiser progression',elem_classes=['secondary-btn'])
                    vfs_status=gr.Textbox(label='Progression / ETA',lines=6,interactive=False)
                with gr.Column(scale=6, elem_classes=['glass']):
                    vfs_out=gr.Video(label='Résultat vidéo',height=520)
                    vfs_info=gr.Textbox(label='Détails',lines=5,interactive=False)
            vfs_analyze.click(_analyze_video,[vfs_tgt],[vfs_analysis,vfs_backend])
            vfs_preview_btn.click(
                _submit_video_preview,
                [vfs_src,vfs_tgt,vfs_stride,vfs_keep_audio,vfs_crf,vfs_preset,vfs_detect_every,vfs_backend,vfs_target_face_position,vfs_reference_frame,vfs_reference_distance],
                [vfs_job,vfs_submit_info,jobs_box]
            )
            vfs_btn.click(
                _submit_video_fs,
                [vfs_src,vfs_tgt,vfs_stride,vfs_max_frames,vfs_keep_audio,vfs_crf,vfs_preset,vfs_detect_every,vfs_preview_seconds,vfs_backend,vfs_target_face_position,vfs_reference_frame,vfs_reference_distance],
                [vfs_job,vfs_submit_info,jobs_box]
            )
            vfs_pause.click(_pause_video_job,[vfs_job],[vfs_submit_info,jobs_box])
            vfs_resume.click(_resume_video_job,[vfs_job],[vfs_submit_info,jobs_box])
            vfs_restart.click(_restart_video_job,[vfs_job],[vfs_submit_info,jobs_box])
            vfs_cancel.click(_cancel_video_job,[vfs_job],[vfs_submit_info,jobs_box])
            vfs_refresh.click(_refresh_video_job,[vfs_job],[vfs_status,vfs_out,vfs_info,jobs_box])
            try:
                if VIDEO_FACE_SWAP_AUTO_REFRESH and hasattr(gr,'Timer'):
                    vfs_timer=gr.Timer(value=max(1,int(AUTO_REFRESH_SECONDS)),active=True)
                    vfs_timer.tick(
                        _refresh_video_job,
                        [vfs_job],
                        [vfs_status,vfs_out,vfs_info,jobs_box],
                        show_progress='hidden'
                    )
            except Exception:
                pass

        with gr.Tab('🔄 Récupérer'):
            with gr.Column(elem_classes=['glass']):
                gr.Markdown('### Retrouver un résultat\nColle un Job ID après avoir changé d’onglet ou être revenu plus tard.')
                lookup_id=gr.Textbox(label='Job ID',placeholder='20260926...')
                lookup_btn=gr.Button('Récupérer',variant='primary',elem_classes=['primary-btn'])
                lookup_status=gr.Textbox(label='État',lines=4,interactive=False)
                lookup_img=gr.Image(label='Résultat',type='filepath',elem_classes=['result-image'],height=520)
                lookup_info=gr.Textbox(label='Informations',lines=2,interactive=False,visible=False)
                lookup_btn.click(_refresh_job,[lookup_id],[lookup_status,lookup_img,lookup_info,jobs_box])

        with gr.Tab('🛠 Technique'):
            with gr.Column(elem_classes=['glass']):
                tech_status=gr.Textbox(label='Bootstrap',value=bootstrap_status_text(),lines=8,interactive=False)
                tech_refresh=gr.Button('↻ Actualiser', elem_classes=['secondary-btn'])
                tech_jobs=gr.Dataframe(
                    headers=['Job ID','Type','État','Créé','Mis à jour','Résultat','Erreur'],
                    value=jobs_table(),interactive=False,label='Jobs récents',wrap=True
                )
                tech_refresh.click(_prepare_status,[],[tech_status,tech_jobs])
                with gr.Row():
                    tech_test=gr.Button('🧪 Self-test vidéo',elem_classes=['secondary-btn'])
                    tech_cleanup=gr.Button('🧹 Nettoyer cache vidéo',elem_classes=['secondary-btn'])
                tech_test_out=gr.Textbox(label='Diagnostic vidéo',lines=7,interactive=False)
                tech_cleanup_out=gr.Textbox(label='Nettoyage',lines=2,interactive=False)
                tech_facefusion=gr.Textbox(label='FaceFusion / cache',value=facefusion_status_text(),lines=3,interactive=False)
                tech_facefusion_refresh=gr.Button('↻ État FaceFusion',elem_classes=['secondary-btn'])
                tech_test.click(_video_selftest,[],[tech_test_out])
                tech_cleanup.click(_cleanup_video_cache,[],[tech_cleanup_out,tech_jobs])
                tech_facefusion_refresh.click(_facefusion_status_ui,[],[tech_facefusion])
                with gr.Accordion('Chemins des modèles',open=False):
                    gr.Markdown(f'**Heretic**  \n{HERETIC_PATH}\n\n**mmproj**  \n{MMPROJ_PATH}\n\n**DiT**  \n{DIT_PATH}\n\n**VAE**  \n{VAE_PATH}')



